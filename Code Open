--
-- QUÉ CAMBIA respecto a la v1:
--
-- SECCIÓN A: además de detectar Sound NUEVOS, ahora también
-- escucha cambios de SoundId en una instancia ya existente
-- (GetPropertyChangedSignal). Esto es porque el juego puede
-- reutilizar el mismo "EmoteSound" y solo cambiarle el SoundId
-- entre un emote y otro, en vez de destruirlo y crear uno nuevo
-- — con la v1 eso se podía perder.
--
-- SECCIÓN B: ahora busca en TODOS los servicios que un LocalScript
-- puede ver desde el cliente (Workspace, ReplicatedStorage,
-- ReplicatedFirst, Lighting, SoundService, StarterGui, Teams).
-- IMPORTANTE — límite real, no una suposición: ServerScriptService
-- y ServerStorage NO se replican al cliente, así que un script del
-- lado del cliente no puede ver su contenido aunque exista en el
-- juego. Si el ID no aparece en ningún lado de acá, o vive en uno
-- de esos dos servicios (inaccesible), o se genera 100% en runtime
-- sin quedar guardado en ninguna instancia fija.
-- Busca coincidencias en: Sound.SoundId, StringValue.Value, y
-- Attributes de cualquier instancia. Todo por tandas con task.wait
-- para no trabar/crashear.
-- Podés buscar un ID pegado a mano, o tocar "Buscar TODOS los
-- capturados" para repetir la búsqueda con cada ID que ya viste
-- en la Sección A.
--
-- SECCIÓN C: agrega algo que la v1 no probaba — el extractor
-- original solo mira instancias Sound colgadas del ModuleScript
-- del emote. Pero el dato también podría estar adentro de la
-- TABLA que devuelve ese ModuleScript al hacer require() (no como
-- instancia, como valor Lua). Esta sección busca el módulo del
-- emote por nombre interno, lo requiere con pcall, y vuelca su
-- contenido (strings/números/tablas anidadas) al log para
-- inspeccionarlo a simple vista.

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- ── ESTADO ────────────────────────────────────────────────────
local State = {
    paused     = false,
    entries    = {},
    scanning   = false,
    capturedIds = {},   -- set: [id] = true, en orden de aparición también en capturedOrder
    capturedOrder = {},
}

local watcherConn = nil
local connectedSounds = setmetatable({}, { __mode = "k" })
local logLabel = nil
local scroll = nil

-- ── LOG ───────────────────────────────────────────────────────
local function refreshLogUI()
    if not logLabel then return end
    logLabel.Text = table.concat(State.entries, "\n")
    task.defer(function()
        if scroll then
            scroll.CanvasPosition = Vector2.new(0, math.huge)
        end
    end)
end

local function addLog(text)
    if State.paused then return end
    table.insert(State.entries, text)
    if #State.entries > 400 then
        table.remove(State.entries, 1)
    end
    refreshLogUI()
end

local function registerCapturedId(id)
    if id == "" or id == "rbxassetid://" then return end
    if not State.capturedIds[id] then
        State.capturedIds[id] = true
        table.insert(State.capturedOrder, id)
    end
end

-- ── SECCIÓN A: WATCHER DE SONIDO REAL (con soporte reutilización) ──
local function findOwnCharModel()
    local playersFolder = workspace:FindFirstChild("Players")
    if not playersFolder then return nil, "No existe workspace.Players" end
    local charModel = playersFolder:FindFirstChild(lp.Name)
    if not charModel then return nil, "No encuentro workspace.Players." .. lp.Name end
    return charModel, nil
end

-- Nombres de Sound que NO son emotes (movimiento normal del personaje).
-- Se filtra por Name, no por SoundId, porque IDs como FootstepSound
-- cambian todo el tiempo (superficie/pisada) pero el Name es estable.
local EXCLUDED_SOUND_NAMES = {
    SlideSound    = true,
    FootstepSound = true,
    Whoosh        = true,
    DoubleJump    = true,
    Equip         = true,
    Death         = true,
    DeathHeavy    = true,
}

local function hookSoundInstance(inst)
    if EXCLUDED_SOUND_NAMES[inst.Name] then return end
    if connectedSounds[inst] then return end
    connectedSounds[inst] = true

    local function report(tag)
        local id = tostring(inst.SoundId)
        registerCapturedId(id)
        addLog(("[%s] %s | SoundId=%s | %s"):format(tag, inst.Name, id, inst:GetFullName()))
    end

    report("SONIDO")
    inst:GetPropertyChangedSignal("SoundId"):Connect(function()
        report("SONIDO-CAMBIO")
    end)
end

local function startWatch()
    if watcherConn then return end
    local charModel, err = findOwnCharModel()
    if not charModel then
        addLog("[ERROR] " .. err .. " (¿ya entraste a una partida?)")
        return
    end

    -- Hookear los Sound que ya existan ahora mismo
    for _, inst in ipairs(charModel:GetDescendants()) do
        if inst:IsA("Sound") then hookSoundInstance(inst) end
    end

    watcherConn = charModel.DescendantAdded:Connect(function(inst)
        if inst:IsA("Sound") then
            task.defer(function() hookSoundInstance(inst) end)
        end
    end)

    addLog("[OK] Escuchando (nuevo + cambios) en " .. charModel:GetFullName())
    addLog("     Ahora jugá un emote real desde el menú del juego.")
end

local function stopWatch()
    if watcherConn then
        watcherConn:Disconnect()
        watcherConn = nil
    end
    addLog("[OK] Watcher detenido.")
end

-- ── SECCIÓN B: BÚSQUEDA MULTI-RAÍZ POR PARTES ────────────────
local function getAccessibleRoots()
    -- Solo servicios que SÍ se replican al cliente. ServerScriptService
    -- y ServerStorage no están acá a propósito: un LocalScript no puede
    -- verlos, no es que nos olvidamos de buscarlos.
    local names = {
        "Workspace", "ReplicatedStorage", "ReplicatedFirst",
        "Lighting", "SoundService", "StarterGui", "Teams",
    }
    local roots = {}
    for _, n in ipairs(names) do
        local ok, svc = pcall(function() return game:GetService(n) end)
        if ok and svc then table.insert(roots, { name = n, inst = svc }) end
    end
    return roots
end

local function instanceMatches(inst, targetSet)
    if inst:IsA("Sound") then
        local id = tostring(inst.SoundId)
        if targetSet[id] then return "Sound.SoundId", id end
    elseif inst:IsA("StringValue") then
        local v = tostring(inst.Value)
        if targetSet[v] then return "StringValue.Value", v end
    end
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if ok and attrs then
        for k, v in pairs(attrs) do
            local vs = tostring(v)
            if targetSet[vs] then return "Attribute:" .. k, vs end
        end
    end
    return nil
end

local function scanRootsForIds(targetList)
    if State.scanning then
        addLog("[AVISO] Ya hay una búsqueda en curso, esperá a que termine.")
        return
    end
    if #targetList == 0 then
        addLog("[ERROR] No hay ningún ID para buscar todavía.")
        return
    end

    local targetSet = {}
    for _, id in ipairs(targetList) do targetSet[id] = true end

    State.scanning = true
    addLog(("[BUSCANDO] %d ID(s) en todas las rutas accesibles del cliente..."):format(#targetList))

    task.spawn(function()
        local roots = getAccessibleRoots()
        local totalMatches = 0

        for _, root in ipairs(roots) do
            addLog("[RAÍZ] " .. root.name .. " ...")
            local ok, all = pcall(function() return root.inst:GetDescendants() end)
            if not ok then
                addLog("  [ERROR] No se pudo listar " .. root.name)
            else
                local total = #all
                local CHUNK = 300
                for i = 1, total do
                    local inst = all[i]
                    local ok2, kind, val = pcall(instanceMatches, inst, targetSet)
                    if ok2 and kind then
                        totalMatches = totalMatches + 1
                        addLog(("  [MATCH %d] %s = %s | %s"):format(totalMatches, kind, val, inst:GetFullName()))
                    end
                    if i % CHUNK == 0 then
                        task.wait()
                    end
                end
                addLog(("  [OK] %s revisado (%d instancias)."):format(root.name, total))
            end
            task.wait()
        end

        if totalMatches == 0 then
            addLog("[FIN] Ningún ID apareció como Sound/StringValue/Attribute en ninguna raíz accesible.")
            addLog("      No implica que no exista — puede estar en ServerScriptService/ServerStorage")
            addLog("      (inaccesibles desde el cliente) o generarse en runtime sin quedar guardado.")
        else
            addLog(("[FIN] Búsqueda terminada. %d coincidencia(s) en total."):format(totalMatches))
        end
        State.scanning = false
    end)
end

-- ── SECCIÓN C: INSPECCIONAR MÓDULO DEL EMOTE (require) ───────
local function findEmoteModule(emoteName)
    local RS = game:GetService("ReplicatedStorage")
    local roots = {}
    local items = RS:FindFirstChild("Items")
    if items then
        local packs = items:FindFirstChild("ItemPacks")
        if packs then table.insert(roots, packs) end
        local baseItems = items:FindFirstChild("BaseItems")
        if baseItems then table.insert(roots, baseItems) end
    end
    table.insert(roots, RS)

    for _, root in ipairs(roots) do
        for _, inst in ipairs(root:GetDescendants()) do
            if inst.ClassName == "ModuleScript" and inst.Name == emoteName then
                return inst
            end
        end
    end
    return nil
end

local function dumpValue(v, indent, depth, out)
    if depth > 4 then
        table.insert(out, indent .. "...(demasiado profundo, corto acá)")
        return
    end
    local t = typeof(v)
    if t == "table" then
        local any = false
        for k, val in pairs(v) do
            any = true
            local kt = tostring(k)
            local vt = typeof(val)
            if vt == "table" then
                table.insert(out, indent .. kt .. ":")
                dumpValue(val, indent .. "  ", depth + 1, out)
            elseif vt == "Instance" then
                table.insert(out, indent .. kt .. " = <" .. val.ClassName .. " " .. val.Name .. ">")
            else
                table.insert(out, indent .. kt .. " = " .. tostring(val))
            end
        end
        if not any then table.insert(out, indent .. "(tabla vacía)") end
    else
        table.insert(out, indent .. tostring(v))
    end
end

local function inspectModule(emoteName)
    if emoteName == "" then
        addLog("[ERROR] Escribí el nombre interno del emote primero (ej: Griddy).")
        return
    end
    addLog("[INSPECCIONANDO] " .. emoteName .. " ...")
    local mod = findEmoteModule(emoteName)
    if not mod then
        addLog("[ERROR] No encontré ningún ModuleScript llamado " .. emoteName .. ".")
        return
    end
    addLog("[OK] Módulo encontrado: " .. mod:GetFullName())

    local ok, result = pcall(require, mod)
    if not ok then
        addLog("[ERROR] require() falló: " .. tostring(result))
        return
    end

    local out = {}
    dumpValue(result, "  ", 1, out)
    if #out == 0 then
        addLog("[OK] El módulo no devolvió una tabla con contenido (o devolvió algo simple).")
    else
        addLog("[CONTENIDO DEL MÓDULO]")
        for _, line in ipairs(out) do
            addLog(line)
            if line:lower():find("rbxassetid") then
                addLog("     ^ contiene un rbxassetid, revisar esta línea")
            end
        end
    end
end

